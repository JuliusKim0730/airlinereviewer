# Leave empty to run in development mode (everything stored in this browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: real aircraft type / schedule lookup (RapidAPI AeroDataBox).
# Without it, the flight card shows what the boarding pass contains.
AERODATABOX_API_KEY=

# Optional: partner search links. {query} is replaced with the city name.
# Affiliate params are appended as a query string (e.g. partner_id=123).
MYREALTRIP_SEARCH_URL=
MYREALTRIP_AFFILIATE_PARAMS=
KLOOK_SEARCH_URL=
KLOOK_AFFILIATE_PARAMS=
MONKEYTRAVEL_SEARCH_URL=
MONKEYTRAVEL_AFFILIATE_PARAMS=
